---
import { Image } from 'astro:assets'
import { render, type CollectionEntry, type CollectionKey } from 'astro:content'
import type { HTMLTag, Polymorphic } from 'astro/types'

import { cn } from '../../utils'
import { Button, FormattedDate } from '../user'

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
  post: CollectionEntry<CollectionKey>
  detailed?: boolean
  class?: string
}

const { as: Tag = 'div', post, detailed = false, class: className } = Astro.props
const { id, data } = post
const { remarkPluginFrontmatter } = await render(post)
const postDate = data.updatedDate ?? data.publishDate
---

<li
  class={cn(
    'post-preview border-b border-border/75',
    detailed ? 'detailed py-5 sm:py-6' : 'compact',
    className
  )}
>
  <a
    class={cn(
      'post-link group block text-foreground',
      detailed && 'sm:grid sm:grid-cols-[1fr_auto]'
    )}
    href={`/blog/${id}`}
    data-astro-prefetch
  >
    <Tag class='min-w-0'>
      <div class='title-row'>
        <div class={cn('post-title', detailed && 'detailed-title')}>
          {data.draft && <span class='text-red-500'>(Draft) </span>}
          {data.title}
        </div>
        {
          !detailed && (
            <span class='compact-date'>
              <FormattedDate date={postDate} />
            </span>
          )
        }
      </div>

      {
        detailed ? (
          <>
            <p class='description'>{data.description}</p>
            <div class='metadata'>
              <FormattedDate date={postDate} />
              <span aria-hidden='true'>·</span>
              <span>{remarkPluginFrontmatter.minutesRead}</span>
              {data.language && (
                <>
                  <span aria-hidden='true'>·</span>
                  <span>{data.language}</span>
                </>
              )}
            </div>
          </>
        ) : (
          <div class='compact-meta'>
            <FormattedDate date={postDate} />
            <span aria-hidden='true'>·</span>
            <span>{remarkPluginFrontmatter.minutesRead}</span>
          </div>
        )
      }
    </Tag>

    {
      detailed && data.heroImage && (
        <Image
          alt={data.heroImage.alt || data.title}
          class='thumbnail'
          loading='lazy'
          {...data.heroImage}
        />
      )
    }
  </a>

  {
    detailed && data.tags && (
      <ul class='tag-list'>
        {data.tags.map((tag: string) => (
          <li>
            <Button title={tag} href={`/tags/${tag}`} variant='pill' />
          </li>
        ))}
      </ul>
    )
  }
</li>

<style>
  .post-link {
    transition: color 160ms ease;
  }

  .post-link:hover .post-title {
    color: hsl(var(--primary));
  }

  .compact .post-link {
    padding-block: 1rem;
  }

  .title-row {
    display: flex;
    min-width: 0;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .post-title {
    min-width: 0;
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.55;
    transition: color 160ms ease;
  }

  .detailed-title {
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .compact-date,
  .compact-meta,
  .metadata {
    color: hsl(var(--muted-foreground));
    font-size: 0.75rem;
    white-space: nowrap;
  }

  .compact-meta {
    display: none;
    gap: 0.35rem;
    margin-top: 0.25rem;
  }

  .description {
    display: -webkit-box;
    max-width: 42rem;
    margin: 0.65rem 0 0;
    overflow: hidden;
    color: hsl(var(--muted-foreground));
    font-size: 0.875rem;
    line-height: 1.7;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .metadata {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.85rem;
  }

  .thumbnail {
    width: 7.5rem;
    height: 5rem;
    margin-left: 2rem;
    border: 1px solid hsl(var(--border) / 0.7);
    border-radius: 0.55rem;
    object-fit: cover;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0.85rem 0 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 639px) {
    .compact-date {
      display: none;
    }

    .compact-meta {
      display: flex;
    }

    .thumbnail {
      display: none;
    }

    .detailed-title {
      font-size: 1.05rem;
    }
  }
</style>
