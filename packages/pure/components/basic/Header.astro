---
import config from 'virtual:config'

import { Svg } from '../user'

const pathname = Astro.url.pathname
const isActive = (link: string) => pathname === link || (link !== '/' && pathname.startsWith(link))
const searchIcon = import('../../../../src/assets/icons/lucide/search.svg?raw')
const monitorIcon = import('../../../../src/assets/icons/lucide/monitor.svg?raw')
const sunIcon = import('../../../../src/assets/icons/lucide/sun.svg?raw')
const moonIcon = import('../../../../src/assets/icons/lucide/moon.svg?raw')
const menuIcon = import('../../../../src/assets/icons/lucide/menu.svg?raw')
---

<header-component
  class='group sticky top-3 z-50 max-md:z-30 mb-12 flex min-h-12 items-center justify-between rounded-2xl border border-transparent px-1.5 sm:top-4'
>
  <a
    class='brand-link z-30 flex min-h-11 items-center px-2 text-[0.95rem] font-semibold tracking-tight'
    href='/'
    aria-label={`${config.author} 首页`}
  >
    <span>{config.author}</span>
  </a>

  <div class='flex items-center gap-x-2'>
    {/* Menu links */}
    <div
      id='headerExpandContent'
      class='end-0 start-0 top-14 grid border border-transparent group-[.expanded]:opacity-100 max-sm:absolute max-sm:opacity-0 max-sm:group-[.expanded]:rounded-2xl max-sm:group-[.expanded]:border-border max-sm:group-[.expanded]:px-3 max-sm:group-[.expanded]:py-2 sm:grid-rows-1'
    >
      <div class='flex flex-col items-center justify-center overflow-hidden sm:flex-row'>
        {
          config.header.menu.map((item) => (
            <a
              href={item.link}
              class:list={[
                'nav-link w-full flex-none grow py-2.5 text-right text-sm sm:w-fit sm:px-3 sm:text-center',
                isActive(item.link) && 'is-active'
              ]}
              aria-current={isActive(item.link) ? 'page' : undefined}
            >
              {item.title}
            </a>
          ))
        }
        <div class='flex w-full grow flex-row justify-end gap-x-3 sm:w-fit sm:gap-x-5'>
          <a class='icon-button' href='/search' title='搜索'>
            <span class='sr-only'>Search</span>
            <Svg src={searchIcon} class='ui-icon size-5' aria-hidden='true' />
          </a>
        </div>
      </div>
    </div>

    {/* buttons */}
    <div class='z-30 flex gap-x-1.5'>
      <button
        id='toggleDarkMode'
        class='icon-button group/dark'
        type='button'
        aria-label='切换外观'
      >
        <span class='sr-only'>切换外观</span>
        <Svg
          src={monitorIcon}
          class='ui-icon system size-5 group-hover/dark:text-primary'
          aria-hidden='true'
        />
        <Svg
          src={sunIcon}
          class='ui-icon light hidden size-5 group-hover/dark:text-primary'
          aria-hidden='true'
        />
        <Svg
          src={moonIcon}
          class='ui-icon dark hidden size-5 group-hover/dark:text-primary'
          aria-hidden='true'
        />
      </button>
      <button
        id='toggleMenu'
        class='icon-button sm:hidden'
        type='button'
        aria-expanded='false'
        aria-controls='headerExpandContent'
      >
        <span class='sr-only'>打开导航</span>
        <Svg src={menuIcon} class='ui-icon size-5' aria-hidden='true' />
      </button>
    </div>
  </div>
</header-component>

{/* Use inline to load icon quicker firstly */}
<script is:inline>
  const toggleDarkModeElement = document.getElementById('toggleDarkMode')
  if (toggleDarkModeElement) {
    toggleDarkModeElement.dataset.theme = localStorage.getItem('theme') || 'system'
  }
</script>
<script>
  import { setTheme, showToast } from '../../utils'

  class HeaderComponent extends HTMLElement {
    constructor() {
      super()
    }

    connectedCallback() {
      // Header
      let preScrollY = window.scrollY
      this.classList.toggle('not-top', preScrollY > 20)
      window.addEventListener('scroll', () => {
        this.classList.toggle('not-top', window.scrollY > 20)
        this.dataset.show = (window.scrollY < 350 || window.scrollY < preScrollY).toString()
        preScrollY = window.scrollY
      })

      // Dark Mode
      const darkModeBtn = this.querySelector('#toggleDarkMode') as HTMLElement
      darkModeBtn.addEventListener('click', () => {
        // Old way: dispatch event
        // const toggleDarkModeEvent = new CustomEvent('theme-change', {
        //   detail: { theme: localStorage.getItem('theme') === 'light' ? 'dark' : 'light' }
        // })
        // document.dispatchEvent(toggleDarkModeEvent)
        const newTheme = setTheme(undefined, true)
        darkModeBtn.dataset.theme = newTheme
        showToast({ message: `Set theme to ${newTheme}` })
      })

      // Menu
      this.querySelector('#toggleMenu')?.addEventListener('click', () => {
        this.classList.toggle('expanded')
        const menuButton = this.querySelector('#toggleMenu')
        menuButton?.setAttribute('aria-expanded', String(this.classList.contains('expanded')))
      })
    }
  }

  customElements.define('header-component', HeaderComponent)
</script>

<style>
  header-component {
    transition:
      transform 260ms cubic-bezier(0.22, 1, 0.36, 1),
      margin-inline 260ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 180ms ease,
      background-color 180ms ease,
      box-shadow 180ms ease;

    &.not-top {
      border-color: hsl(var(--border) / 0.78);
      background: hsl(var(--background) / 0.76);
      -webkit-backdrop-filter: saturate(165%) blur(20px);
      backdrop-filter: saturate(165%) blur(20px);
      box-shadow: 0 8px 28px hsl(var(--shadow-color) / 0.06);
    }
    &[data-show='false']:not(.expanded) {
      transform: translateY(-5rem);
    }
  }
  @media (min-width: 800px) {
    header-component.not-top {
      margin-inline: 6%;
    }
  }
  @media (min-width: 640px) {
    #toggleMenu {
      display: none;
    }
  }
  :global(.dark) header-component.not-top {
    background: hsl(var(--background) / 0.72);
  }

  .nav-link {
    position: relative;
    color: hsl(var(--muted-foreground));
    transition:
      color 180ms ease,
      background-color 180ms ease;
  }
  .nav-link:hover,
  .nav-link.is-active {
    color: hsl(var(--foreground));
  }
  .nav-link.is-active::after {
    position: absolute;
    right: 0.75rem;
    bottom: 0.28rem;
    left: 0.75rem;
    height: 1px;
    content: '';
    background: hsl(var(--primary));
  }

  .icon-button {
    display: inline-flex;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    border: 1px solid transparent;
    border-radius: 50%;
    color: hsl(var(--muted-foreground));
    transition:
      color 180ms ease,
      background-color 180ms ease,
      border-color 180ms ease;
  }
  .icon-button:hover {
    border-color: hsl(var(--border) / 0.8);
    color: hsl(var(--foreground));
    background: hsl(var(--muted) / 0.86);
  }

  :global(.ui-icon) {
    stroke-width: 1.75;
    vector-effect: non-scaling-stroke;
  }

  /* header menu */
  @media (max-width: 640px) {
    #headerExpandContent {
      grid-template-rows: 0fr;
      transition:
        opacity 0.3s,
        padding 0.3s,
        border-color 0.15s,
        grid-template-rows 0.3s;
    }
    .expanded #headerExpandContent {
      grid-template-rows: 1fr;
      background: hsl(var(--background) / 0.94);
      -webkit-backdrop-filter: saturate(160%) blur(20px);
      backdrop-filter: saturate(160%) blur(20px);
      box-shadow: 0 18px 44px hsl(var(--shadow-color) / 0.14);
    }
    .expanded.not-top #headerExpandContent {
      box-shadow:
        rgb(255, 255, 255) 0px 0px 0px 0px,
        rgba(24, 24, 27, 0.08) 0px 0px 0px 1px,
        rgba(39, 39, 42, 0.08) 0px 10px 15px -3px,
        rgba(39, 39, 42, 0.08) 0px 4px 6px -4px;
    }

    /* header component after */
    header-component #headerExpandContent::after {
      box-sizing: content-box;
      content: '';
      position: absolute;
      inset-inline: calc(-1rem - 1px);
      bottom: 0;
      top: -5rem;
      z-index: -1;
      transition: 0.3s;
      visibility: hidden;
      opacity: 0;
      border-bottom: 1px solid transparent;
    }
    header-component:not(.not-top) #headerExpandContent::after {
      visibility: visible;
      bottom: -1rem;
      opacity: 1;
      background-color: hsl(var(--muted) / var(--un-bg-opacity, 1));
      border-bottom-color: hsl(var(--border) / var(--un-border-opacity, 1));
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    header-component.not-top,
    .expanded #headerExpandContent {
      background: hsl(var(--background));
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  /* dark light mode toggle */
  #toggleDarkMode {
    &[data-theme='dark'] {
      & .system {
        display: none;
      }
      & .dark {
        display: block;
      }
    }
    &[data-theme='light'] {
      & .system {
        display: none;
      }
      .light {
        display: block;
      }
    }
  }
</style>
