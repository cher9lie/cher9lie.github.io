---
import { Image } from 'astro:assets'

import { PostPreview } from 'astro-pure/components/pages'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'
import HomeGlobeBackground from '@/components/home/HomeGlobeBackground.astro'
import config from '@/site-config'

const posts = sortMDByDate(await getBlogCollection()).slice(0, 8)
const imagePath = config.logo.src
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/*.{jpeg,jpg,png,gif,avif,webp}'
)

if (!images[imagePath]) throw new Error(`Cannot find homepage image: ${imagePath}`)
---

<PageLayout meta={{ title: '首页' }}>
  <HomeGlobeBackground />

  <main class='home-shell'>
    <section class='intro' id='content-header' aria-labelledby='home-title'>
      <Image
        src={images[imagePath]()}
        alt={config.logo.alt || config.author}
        class='avatar'
        loading='eager'
        fetchpriority='high'
      />
      <div>
        <h1 id='home-title'>{config.author}</h1>
        <p class='fields'>地理信息 · 软件 · 网络</p>
        <p class='lede'>一些技术文章、项目记录与长期笔记。</p>
        <nav class='intro-links' aria-label='个人链接'>
          <a href='/blog'>文章</a>
          <a href='/about'>关于</a>
          <a href='https://github.com/cher9lie' target='_blank' rel='noreferrer'>GitHub ↗</a>
        </nav>
      </div>
    </section>

    <div class='home-content' id='content'>
      {
        posts.length > 0 && (
          <section class='post-section' aria-labelledby='recent-posts-title'>
            <div class='section-heading'>
              <h2 id='recent-posts-title'>最近文章</h2>
              <a href='/blog'>全部文章</a>
            </div>
            <ul>
              {posts.map((post) => (
                <PostPreview {post} />
              ))}
            </ul>
          </section>
        )
      }

      <section class='elsewhere' aria-labelledby='elsewhere-title'>
        <h2 id='elsewhere-title'>其他内容</h2>
        <div class='elsewhere-list'>
          <a href='/docs'>
            <span>文档</span><small>整理过的资料与备忘</small><span aria-hidden='true'>→</span>
          </a>
          <a href='/projects'>
            <span>项目</span><small>正在做和曾经做过的事</small><span aria-hidden='true'>→</span>
          </a>
          <a href='/dn42'>
            <span>DN42</span><small>网络实验与节点信息</small><span aria-hidden='true'>→</span>
          </a>
        </div>
      </section>
    </div>
  </main>
</PageLayout>

<style>
  .home-shell {
    position: relative;
    z-index: 1;
    width: min(100%, 56rem);
    margin-inline: auto;
  }

  .intro {
    display: flex;
    min-height: 30rem;
    width: min(31rem, 58%);
    align-items: center;
    gap: 1.25rem;
    padding-block: 4rem 6rem;
  }

  .avatar {
    width: 4.5rem;
    height: 4.5rem;
    flex: 0 0 auto;
    border: 1px solid hsl(var(--border));
    border-radius: 50%;
    object-fit: cover;
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 650;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  .fields {
    margin: 0.55rem 0 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.875rem;
  }

  .lede {
    max-width: 27rem;
    margin: 1.1rem 0 0;
    color: hsl(var(--foreground) / 0.82);
    line-height: 1.75;
  }

  .intro-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.25rem;
    font-size: 0.875rem;
  }

  .intro-links a,
  .section-heading a {
    color: hsl(var(--muted-foreground));
    text-underline-offset: 0.25rem;
  }

  .intro-links a:hover,
  .section-heading a:hover {
    color: hsl(var(--foreground));
    text-decoration: underline;
  }

  .home-content {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 14rem;
    gap: 5rem;
    padding-block: 1rem 6rem;
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.35rem;
  }

  h2 {
    margin: 0;
    font-size: 1rem;
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  .section-heading a {
    font-size: 0.8rem;
  }

  .post-section ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .elsewhere h2 {
    padding-bottom: 1rem;
    border-bottom: 1px solid hsl(var(--border) / 0.75);
  }

  .elsewhere-list a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.2rem 0.75rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid hsl(var(--border) / 0.75);
    color: hsl(var(--foreground));
    font-size: 0.9rem;
  }

  .elsewhere-list small {
    grid-column: 1 / -1;
    color: hsl(var(--muted-foreground));
    font-size: 0.75rem;
    line-height: 1.5;
  }

  @media (max-width: 719px) {
    .intro {
      min-height: 34rem;
      width: 100%;
      align-items: flex-start;
      padding-top: 4.5rem;
    }

    .avatar {
      width: 3.75rem;
      height: 3.75rem;
    }

    .home-content {
      grid-template-columns: 1fr;
      gap: 3.5rem;
      padding-bottom: 4rem;
    }
  }
</style>
