---
import { Footer, Header, ThemeProvider } from 'astro-pure/components/basic'
import type { SiteMeta } from 'astro-pure/types'
import BrailleSectionBackdrop from '@/components/backgrounds/BrailleSectionBackdrop.astro'
import BaseHead from '@/components/BaseHead.astro'
import config from '@/site-config'

// Import the global.css file here so that it is included on
// all pages through the use of the <BaseLayout /> component.
import '@/assets/styles/global.css'
import '@/assets/styles/app.css'

interface Props {
  meta: SiteMeta
  highlightColor?: string
}

const {
  meta: { articleDate, description = config.description, ogImage, title },
  highlightColor,
  ...props
} = Astro.props

type BrailleKind = 'blog' | 'docs' | 'projects' | 'links' | 'about' | 'network'

const pathname = Astro.url.pathname
const brailleKind: BrailleKind | undefined =
  pathname.startsWith('/blog') || pathname.startsWith('/archives') || pathname.startsWith('/tags')
    ? 'blog'
    : pathname.startsWith('/docs')
      ? 'docs'
      : pathname.startsWith('/projects')
        ? 'projects'
        : pathname.startsWith('/links')
          ? 'links'
          : pathname.startsWith('/about')
            ? 'about'
            : pathname.startsWith('/dn42')
              ? 'network'
              : undefined
---

<html lang={config.locale.lang}>
  <head>
    <BaseHead {articleDate} {description} {ogImage} {title} />
    <ThemeProvider />
    <script
      is:inline
      data-goatcounter='https://stats.050418.xyz/count'
      async
      src='https://stats.050418.xyz/count.js'></script>
  </head>

  <body class='flex justify-center bg-background text-foreground' {...props}>
    {
      highlightColor && (
        <div
          id='highlight-gradient'
          class='pointer-events-none absolute start-0 top-0 z-0 h-screen w-full opacity-25'
          style={`background-image:linear-gradient(${highlightColor},transparent)`}
        />
      )
    }
    {brailleKind && <BrailleSectionBackdrop kind={brailleKind} />}
    <div
      class='relative z-10 w-full max-w-[70rem] px-4 sm:px-7 lg:px-10 min-h-[100dvh] flex flex-col justify-between'
    >
      <Header />
      <div class='flex-1 w-full'>
        <slot />
      </div>
      <Footer />
    </div>

    {/* Set highlight color */}
    <style define:vars={{ highlightColor }}>
      :global(.highlight) {
        color: var(--highlightColor, hsl(var(--primary) / var(--un-text-opacity))) !important;
      }
      :global(.highlight-bg) {
        background-color: var(
          --highlightColor,
          hsl(var(--primary) / var(--un-text-opacity))
        ) !important;
      }
    </style>

    {/* Subtle entrance for sections that explicitly opt in. */}
    <script>
      function initScrollReveal() {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('in-view')
                observer.unobserve(entry.target)
              }
            })
          },
          { threshold: 0.06, rootMargin: '0px 0px -24px 0px' }
        )

        const revealItems = document.querySelectorAll<HTMLElement>('[data-reveal]')
        revealItems.forEach((el, i) => {
          el.classList.add('reveal')
          el.style.setProperty('--reveal-delay', `${Math.min(i, 5) * 45}ms`)
          observer.observe(el)
        })
      }

      // 初始执行
      initScrollReveal()
      // Astro View Transition 切换后重新执行
      document.addEventListener('astro:after-swap', initScrollReveal)
    </script>
  </body>
</html>
