---
import { cn } from 'astro-pure/utils'
import Pageview from '@/components/goatcounter/Pageview.astro'

interface Props {
  view?: boolean
  comment?: boolean
  class?: string
}

const { view, comment, class: className, ...props } = Astro.props
---

<div class={cn('text-base text-sm text-muted-foreground', className)} {...props}>
  {view && <Pageview />}
  {
    comment && (
      <>
        {view && ' | '}
        <a href='#waline'>
          <span class='waline-comment-count' data-path={Astro.url.pathname} /> comments
        </a>
      </>
    )
  }
</div>
